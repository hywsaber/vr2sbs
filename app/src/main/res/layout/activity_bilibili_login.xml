<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/launcher_screen_padding"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/launcher_screen_padding"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bilibiliLoginBackButton"
            style="@style/Widget.Vr2sbs.Launcher.HelpButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bilibili_login_back" />

        <TextView
            style="@style/TextAppearance.Vr2sbs.Launcher.Status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/bilibili_login_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bilibiliLoginDoneButton"
            style="@style/Widget.Vr2sbs.Launcher.HelpButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/bilibili_login_done" />
    </LinearLayout>

    <TextView
        android:id="@+id/bilibiliLoginStatusText"
        style="@style/TextAppearance.Vr2sbs.Launcher.RuntimeStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/bilibili_login_loading" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/bilibiliLoginProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:indeterminate="true" />

    <WebView
        android:id="@+id/bilibiliLoginWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />
</LinearLayout>
