<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_background"
    android:orientation="vertical"
    android:padding="@dimen/launcher_screen_padding">

    <TextView
        style="@style/TextAppearance.Vr2sbs.Launcher.Status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/smb_scan_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/launcher_section_spacing"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/smbScanProgress"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminate="true"
            app:indicatorSize="22dp"
            app:trackThickness="2dp" />

        <TextView
            android:id="@+id/smbScanStatusText"
            style="@style/TextAppearance.Vr2sbs.Launcher.RuntimeStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/smbScanRescanButton"
        style="@style/Widget.Vr2sbs.Launcher.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/smb_scan_rescan" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/smbScanRememberedHeading"
                style="@style/TextAppearance.Vr2sbs.Launcher.RuntimeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/smb_scan_remembered_heading"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/smbScanRememberedContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/smbScanDevicesHeading"
                style="@style/TextAppearance.Vr2sbs.Launcher.Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/smb_scan_devices_heading"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/smbScanDevicesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
